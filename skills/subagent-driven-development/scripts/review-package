#!/usr/bin/env bash
# Package the current uncommitted working-tree diff for read-only review.
#
# Usage: review-package PLAN_FILE [OUTFILE]
# The package includes tracked changes and complete diffs for untracked files.
set -euo pipefail

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
  echo "usage: review-package PLAN_FILE [OUTFILE]" >&2
  exit 2
fi

plan=$1
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

if [ $# -eq 2 ]; then
  out=$2
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/review-working-tree-$(date +%s%N).diff"
fi

{
  echo "# Review package: current uncommitted working tree"
  echo
  echo "## Status"
  git status --short
  echo
  echo "## Tracked changes"
  git diff --stat HEAD
  git diff -U10 HEAD
  while IFS= read -r -d '' file; do
    echo
    echo "## Untracked file: $file"
    git diff --no-index -- /dev/null "$file" || [ $? -eq 1 ]
  done < <(git ls-files --others --exclude-standard -z)
} > "$out"

echo "wrote ${out}: $(wc -c < "$out" | tr -d ' ') bytes"
